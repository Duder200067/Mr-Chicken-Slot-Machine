    playTone(ctx,82,now,0.5,"sawtooth",0.16);
    playTone(ctx,164,now,0.32,"square",0.11);
    playTone(ctx,659,now+0.02,0.18,"triangle",0.12);
    playTone(ctx,988,now+0.12,0.16,"triangle",0.09);
    playTone(ctx,1318,now+0.24,0.22,"triangle",0.08);
    playTone(ctx,55,now+0.28,0.35,"sine",0.14);
