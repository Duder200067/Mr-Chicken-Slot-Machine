  document.getElementById("helpModal").classList.remove("active");
}

function openCodes(){
  document.getElementById("codesModal").classList.add("active");
  document.getElementById("codeInput").focus();
}

function closeCodes(){
  document.getElementById("codesModal").classList.remove("active");
}

function registerSpin(){
  completedSpinCount++;
  if(completedSpinCount>=nextGambleHint){
    gambleHintPending=true;
    nextGambleHint=completedSpinCount+10+Math.floor(Math.random()*11);
  }
}

function showRareFactoryEvent(){
  const modal=document.getElementById("rareImageModal");
  modal.classList.remove("active");
  void modal.offsetWidth;
  modal.classList.add("active");
  playVineBoom();
  clearTimeout(rareEventTimer);
  rareEventTimer=setTimeout(closeRareFactoryEvent,950);
}

function closeRareFactoryEvent(){
  document.getElementById("rareImageModal").classList.remove("active");
  clearTimeout(rareEventTimer);
  rareEventTimer=null;
}

function enableFactoryMode(){
  factoryMode=true;
  document.body.classList.add("factory-mode");
}

function disableFactoryMode(){
  factoryMode=false;
  document.body.classList.remove("factory-mode");
}

function submitCode(){
  const input=document.getElementById("codeInput");
  const code=input.value.trim();
  if(code==="I love fried chicken"){
    infiniteCoins=true;
    coins=999999999;
    document.getElementById("info").textContent="Code accepted: infinite coins";
    beep(980,0.22);
    closeCodes();
    update();
  }else if(code==="el secreto"){
    guaranteedJackpot=true;
    document.getElementById("info").textContent="Code accepted: next spin is a jackpot";
    beep(760,0.16);
    closeCodes();
    update();
  }else if(code==="factory no good"){
    enableFactoryMode();
    document.getElementById("info").textContent="Code accepted: textures changed";
    beep(690,0.18);
    closeCodes();
  }else if(code==="factory yes good"){
    disableFactoryMode();
    document.getElementById("info").textContent="Code accepted: textures restored";
    beep(880,0.18);
    closeCodes();
  }else if(code==="Tutorial"){
    if(!tutorialActive){
      document.getElementById("info").textContent="The Tutorial code only works during the tutorial";
      beep(180,0.12);
    }else if(tutorialCodeRedeemed){
      document.getElementById("info").textContent="Tutorial code was already used";
      beep(180,0.12);
    }else{
      tutorialCodeRedeemed=true;
      shopMult++;
      document.getElementById("info").textContent="Code accepted: free Multiplier upgrade";
      beep(900,0.2);
      if(tutorialActive&&tutorialStep===3){
        closeCodes();
        setTutorialMessage("Tutorial — Step 5: Check the rest of Menu: Audio, How It Works, and Patterns Menu.");
        input.value="";
        return;
      }
      update();
    }
  }else if(code.toLowerCase()==="lucky ducky"){
    if(luckyDuckyRedeemed){
      document.getElementById("info").textContent="Lucky Ducky was already used this game";
      beep(180,0.12);
    }else{
      luckyDuckyRedeemed=true;
      luck++;
      document.getElementById("info").textContent="Lucky Ducky accepted: free Luck upgrade";
      beep(860,0.18);
      update();
    }
  }else{
    document.getElementById("info").textContent="Code not found";
    beep(180,0.12);
  }
  input.value="";
}

homeTipTimer=setInterval(rotateHomeTip,5000);
update();
