function beep(freq,dur){
  if(!audioOn) return;
  try{
    const ctx=new (window.AudioContext||window.webkitAudioContext)();
    const o=ctx.createOscillator();
    const g=ctx.createGain();
    o.frequency.value=freq;
    o.connect(g);
    g.connect(ctx.destination);
    o.start();
    g.gain.setValueAtTime(0.08*masterVolume,ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.0001,ctx.currentTime+dur);
    o.stop(ctx.currentTime+dur);
  }catch(e){}
}

function playTone(ctx,freq,start,dur,type="sine",volume=0.08){
  if(!audioOn) return;
  const o=ctx.createOscillator();
  const g=ctx.createGain();
  o.type=type;
  o.frequency.setValueAtTime(freq,start);
  g.gain.setValueAtTime(0.0001,start);
  g.gain.exponentialRampToValueAtTime(volume*masterVolume,start+0.02);
  g.gain.exponentialRampToValueAtTime(0.0001,start+dur);
  o.connect(g);
  g.connect(ctx.destination);
  o.start(start);
  o.stop(start+dur+0.03);
}

function playJackpotBuild(){
  if(!audioOn) return;
  try{
    const ctx=new (window.AudioContext||window.webkitAudioContext)();
    const now=ctx.currentTime;
    const notes=[220,277,330,415,554,660,831,988];

    for(let i=0;i<22;i++){
      const start=now+i*0.125;
      const freq=notes[i%notes.length]*(i>15?1.5:1);
      playTone(ctx,freq,start,0.09,i%2?"square":"triangle",0.045+i*0.002);
      if(i%4===0) playTone(ctx,110,start,0.06,"sawtooth",0.035);
    }

    const riser=ctx.createOscillator();
    const gain=ctx.createGain();
    riser.type="sawtooth";
    riser.frequency.setValueAtTime(180,now);
    riser.frequency.exponentialRampToValueAtTime(1200,now+2.75);
    gain.gain.setValueAtTime(0.0001,now);
    gain.gain.exponentialRampToValueAtTime(0.055,now+0.2);
    gain.gain.exponentialRampToValueAtTime(0.0001,now+2.78);
    riser.connect(gain);
    gain.connect(ctx.destination);
    riser.start(now);
    riser.stop(now+2.8);
  }catch(e){}
}

