function scaledCost(base,level,growth){
  return Math.ceil((base*Math.pow(growth,level))/5)*5;
}

function luckCost(){ return scaledCost(25,luck,1.485); }
function multCost(){ return scaledCost(50,shopMult-1,2.025); }
function jackpotCost(){ return scaledCost(40,jackpotLevel,1.62); }
function sickleCost(){ return Math.max(1,Math.round(coins*0.75)); }
function spinCost(){
  if(difficulty==="easy") return 1;
  if(difficulty==="hard") return 1+Math.max(0,spinPriceUpgradeCount-1);
  return 1+Math.floor(spinPriceUpgradeCount/2);
}

function coinGainMultiplier(){
  return difficulty==="easy"?1.1:difficulty==="hard"?.9:1;
}

function applyCoinMode(amount){
  return Math.round(amount*coinGainMultiplier());
}

function randomSymbol(luckySymbol){
  const luckyChance=Math.min(0.48,baseLuckChance+luck*0.035);
  if(luckySymbol&&Math.random()<luckyChance) return luckySymbol;
  return symbols[Math.floor(Math.random()*symbols.length)];
}

function createSpinBoard(luckySymbol){
  const board=Array.from({length:15},()=>randomSymbol(luckySymbol));
  // A small boost occasionally plants one memorable special pattern.
  if(Math.random()<.14){
    const specialPatterns=[
      [0,6,12,8,4], // zig
      [10,6,2,8,14], // zag
      [1,3,7,11,13], // X
      [0,1,2,3,4,5,9,10,11,12,13,14] // border
    ];
    const special=specialPatterns[Math.floor(Math.random()*specialPatterns.length)];
    const specialSymbol=Math.random()<.55?luckySymbol:symbols[Math.floor(Math.random()*symbols.length)];
    special.forEach(index=>board[index]=specialSymbol);
  }
  return board;
}

