function sackSummary(){
  const items=Object.entries(sackInventory)
    .filter(([,count])=>count>0)
    .map(([amount,count])=>`${count}×${Number(amount).toLocaleString()}`);
  return items.length?items.join(", "):"none";
}

function checkSacks(required=1){
  if(infiniteCoins||coins>=required||!hasSacks()) return false;
  const sizes=Object.keys(sackInventory).map(Number).filter(size=>sackInventory[size]>0).sort((a,b)=>a-b);
  const rescue=sizes.find(size=>coins+size>=required)||sizes[sizes.length-1];
  sackInventory[rescue]--;
  coins+=rescue;
  document.getElementById("info").textContent=`A ${rescue.toLocaleString()}-coin sack rescued you!`;
  document.getElementById("earned").textContent="💰 Earned: "+rescue;
  beep(620,0.18);
  return true;
}

