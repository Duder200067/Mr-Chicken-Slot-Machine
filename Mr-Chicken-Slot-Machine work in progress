<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mr. Chicken Slot Machine</title>
<style>
:root{
  --gold:#d18b00;
  --gold-dark:#9b6400;
  --cream:#fff7d6;
  --green:#188a39;
  --ink:#302410;
}
*{box-sizing:border-box}
body{
  margin:0;
  min-height:100vh;
  font-family:Arial,"Segoe UI Emoji","Apple Color Emoji","Noto Color Emoji",sans-serif;
  text-align:center;
  color:var(--ink);
  background:
    radial-gradient(circle at top left, #ffe691 0, transparent 32%),
    linear-gradient(180deg,#fff7d6 0%,#ffe9a3 100%);
}
main{
  width:min(96vw,640px);
  margin:0 auto;
  padding:24px 12px 30px;
}
h1{
  margin:0 0 14px;
  color:var(--gold-dark);
  font-size:clamp(2rem,7vw,3.3rem);
}
.machine{
  position:relative;
  padding:16px;
  border:4px solid var(--gold);
  border-radius:14px;
  background:#fffdf2;
  box-shadow:0 10px 28px rgba(92,58,0,.2);
}
.grid{
  display:grid;
  grid-template-columns:repeat(5,minmax(54px,90px));
  column-gap:6px;
  row-gap:13px;
  justify-content:center;
  margin:4px auto 16px;
  transition:transform .35s ease, filter .35s ease;
}
.mini-slots{
  display:none;
  grid-template-columns:190px 190px;
  grid-template-areas:"lt rt" "lb rb";
  grid-template-rows:1fr 1fr;
  gap:10px;
  position:absolute;
  left:50%;
  top:70px;
  width:min(96vw,1040px);
  min-height:300px;
  transform:translateX(-50%);
  justify-content:space-between;
  align-items:stretch;
  pointer-events:none;
  z-index:1;
}
.mini-slots.active{
  display:grid;
}
.mini-grid:nth-child(1){grid-area:lt}
.mini-grid:nth-child(2){grid-area:rt}
.mini-grid:nth-child(3){grid-area:lb}
.mini-grid:nth-child(4){grid-area:rb}
.mini-grid{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  grid-template-rows:repeat(3,1fr);
  gap:3px;
  padding:6px;
  border:2px solid var(--gold);
  border-radius:8px;
  background:#fffaf0;
  pointer-events:auto;
  min-height:142px;
  width:190px;
  overflow:hidden;
}
.mini-grid.hidden{display:none}
.mini-cell{
  min-width:0;
  aspect-ratio:1;
  border:1px solid #d18b00;
  border-radius:5px;
  background:white;
  font-size:clamp(15px,2.4vw,22px);
  display:flex;
  align-items:center;
  justify-content:center;
}
.mini-cell.win{
  background:#fff59d;
  box-shadow:0 0 8px gold;
}
.cell{
  aspect-ratio:1;
  border:3px solid var(--gold);
  border-radius:10px;
  background:white;
  font-size:clamp(28px,8vw,42px);
  display:flex;
  align-items:center;
  justify-content:center;
  transition:background .18s, box-shadow .18s, transform .18s;
}
/* Factory no good replaces every visual surface while keeping controls readable. */
body.factory-mode,
body.factory-mode *{
  background-color:#ffb100 !important;
  background-image:url("factory-no-good.png") !important;
  background-size:100% 100% !important;
  background-position:center !important;
  background-repeat:no-repeat !important;
}
body.factory-mode{background-attachment:fixed}
body.factory-mode button,
body.factory-mode input{color:#fff7d6;text-shadow:1px 1px 2px #000,0 0 4px #000}
body.factory-mode button:hover,
body.factory-mode button:disabled,
body.factory-mode .modal{background-image:url("factory-no-good.png") !important}
.grid{position:relative;z-index:2}
.win{
  background:#fff59d;
  box-shadow:0 0 14px gold;
  transform:scale(1.04);
}
.grid.jackpot-mode{
  transform:scale(1.08);
  filter:drop-shadow(0 12px 22px rgba(209,139,0,.32));
}
.cell.locked{
  background:#fff2a6;
  box-shadow:0 0 18px rgba(255,191,0,.78);
  animation:lockedPulse .55s ease-in-out infinite alternate;
}
.cell.suspense{
  z-index:2;
  border-color:#ff5b35;
  background:#fff;
  box-shadow:0 0 26px rgba(255,91,53,.95),0 0 48px rgba(255,213,79,.9);
  animation:suspenseShake .16s linear infinite, suspenseGlow .5s ease-in-out infinite alternate;
}
.cell.final-focus{
  z-index:3;
  border-color:#ff2d00;
  box-shadow:0 0 34px rgba(255,45,0,1),0 0 70px rgba(255,213,79,1);
  animation:finalFocusShake .13s linear infinite, suspenseGlow .38s ease-in-out infinite alternate;
}
.cell.jackpot-pop{
  animation:jackpotPop .7s cubic-bezier(.2,1.5,.35,1) both;
}
#info.jackpot-text{
  font-size:clamp(1.15rem,4vw,1.65rem);
  color:#c83d13;
  text-shadow:0 0 14px rgba(255,213,79,.85);
  animation:textPulse .45s ease-in-out infinite alternate;
}
@keyframes lockedPulse{
  from{transform:scale(1);filter:saturate(1)}
  to{transform:scale(1.06);filter:saturate(1.35)}
}
@keyframes suspenseShake{
  0%,100%{transform:scale(1.22) rotate(-2deg)}
  50%{transform:scale(1.31) rotate(2deg)}
}
@keyframes finalFocusShake{
  0%,100%{transform:scale(1.48) rotate(-3deg)}
  50%{transform:scale(1.62) rotate(3deg)}
}
@keyframes suspenseGlow{
  from{filter:saturate(1)}
  to{filter:saturate(1.8)}
}
@keyframes jackpotPop{
  0%{transform:scale(1.35) rotate(-4deg)}
  55%{transform:scale(1.7) rotate(3deg)}
  100%{transform:scale(1.08) rotate(0)}
}
@keyframes textPulse{
  from{transform:scale(1)}
  to{transform:scale(1.05)}
}
button{
  min-height:42px;
  padding:10px 14px;
  margin:5px;
  border:2px solid var(--gold);
  border-radius:8px;
  background:#fff6c7;
  color:#3c2a00;
  font-weight:bold;
  cursor:pointer;
}
button:hover{background:#ffe88c}
button:disabled{
  opacity:.55;
  cursor:not-allowed;
}
#spinBtn{
  width:min(260px,90%);
  font-size:1.08rem;
  background:#ffd54f;
}
.spin-row{
  display:flex;
  justify-content:center;
  align-items:center;
  gap:6px;
  flex-wrap:wrap;
}
#spinModeBtn,#audioBtn,#menuBtn{
  min-width:84px;
}
#audioBtn{display:none}
.panel{
  border:1px solid #c7aa55;
  background:white;
  width:min(100%,360px);
  margin:14px auto;
  padding:12px;
  border-radius:10px;
}
.panel-title{
  display:block;
  margin-bottom:6px;
  font-size:1.08rem;
}
#market{
  border-width:2px;
  border-color:var(--gold);
  background:#fffaf0;
  margin-bottom:0;
}
#stats{
  margin-top:8px;
  font-weight:bold;
}
#earned{
  min-height:34px;
  font-size:28px;
  color:var(--green);
  font-weight:bold;
  margin-top:10px;
}
#info{
  min-height:24px;
  font-weight:bold;
  color:var(--gold-dark);
}
#darkCoin{
  position:fixed;
  left:12px;
  bottom:12px;
  width:38px;
  height:38px;
  border-radius:50%;
  border:3px solid #1d160d;
  background:radial-gradient(circle at 35% 30%,#4b3a1d,#111 68%);
  box-shadow:0 0 16px rgba(0,0,0,.55);
  cursor:pointer;
}
#sideMenu{
  position:fixed;
  right:12px;
  top:12px;
  z-index:8;
}
#sickleOffer{
  display:none;
  position:fixed;
  right:12px;
  bottom:12px;
  z-index:9;
  padding:12px;
  border:3px solid var(--gold);
  border-radius:10px;
  background:#fffdf2;
  box-shadow:0 12px 28px rgba(48,36,16,.28);
}
#sickleOffer.active{
  display:block;
}
.modal{
  display:none;
  position:fixed;
  inset:0;
  z-index:12;
  align-items:center;
  justify-content:center;
  padding:18px;
  background:rgba(28,20,10,.52);
}
.modal.active{
  display:flex;
}
#startModal{z-index:30;background:linear-gradient(135deg,rgba(255,222,92,.96),rgba(247,142,12,.96))}
.start-card{width:min(95vw,570px);padding:46px 28px;background:linear-gradient(145deg,#fff7a8,#ffbf2f 55%,#ef8305)}
.start-card h2{font-size:clamp(2.45rem,9vw,4rem);margin-bottom:10px}
.start-card p{margin:0 0 16px;font-weight:bold}
.difficulty-options{display:none;gap:8px;margin-top:14px}
.difficulty-options.active{display:grid}
.difficulty-options button{margin:0}
.difficulty-options small{display:block;margin-top:3px;font-weight:normal}
.sack-activate{display:none;position:fixed;z-index:26;right:18px;top:35%;width:190px;padding:12px;border:3px solid var(--gold);border-radius:14px;background:#fffdf2;box-shadow:0 10px 24px rgba(48,36,16,.3)}
.sack-activate.active{display:block}
.bag{position:relative;width:80px;height:92px;margin:8px auto;border-radius:40% 40% 30% 30%;background:#96613b;box-shadow:inset 12px 0 rgba(255,255,255,.18),inset -10px 0 rgba(0,0,0,.18);border:2px solid rgba(70,35,10,.5)}
.bag::before{content:"";position:absolute;left:15px;top:-16px;width:46px;height:28px;border-radius:50%;background:inherit;border:2px solid rgba(70,35,10,.5)}
.bag::after{content:"";position:absolute;left:9px;right:9px;top:12px;border-top:4px solid #f3cd7d}
.bag-name{font-weight:bold;color:#6f4116}
.patterns-card{width:min(96vw,760px);max-height:88vh;overflow:auto}
.pattern-gallery{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:12px;margin:14px 0;text-align:center}
.pattern-tile{padding:10px;border:2px solid #e1ac20;border-radius:12px;background:#fff8d9}
.pattern-mini{display:grid;grid-template-columns:repeat(5,18px);grid-template-rows:repeat(3,18px);gap:3px;justify-content:center;margin:0 auto 8px}
.pattern-mini span{border:1px solid #c98700;border-radius:4px;background:#fffdf2}
.pattern-mini span.on{background:#fff27b;box-shadow:0 0 7px #ffbc00}
.pattern-payout{font-weight:bold;color:#875500}
#retryModal{z-index:28}.retry-card{width:min(92vw,350px)}
@media(max-width:850px){.sack-activate{right:8px;top:auto;bottom:12px}}
#tutorialGuide{
  display:none;
  position:fixed;
  z-index:25;
  top:14px;
  left:50%;
  width:min(92vw,470px);
  transform:translateX(-50%);
  padding:14px 18px;
  border:4px solid var(--gold);
  border-radius:14px;
  color:var(--ink);
  background:#fffdf2;
  box-shadow:0 10px 24px rgba(48,36,16,.32);
  font-weight:bold;
  pointer-events:none;
}
#tutorialGuide.active{display:block}
#doubleError{min-height:18px;margin:5px 0 0;color:#c92816;font-size:.82rem;font-weight:bold}
.sack-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px;margin:10px 0}
.sack-small{background:#a76c40}.sack-regular{background:#377cc9}.sack-large{background:#3e994d}.sack-massive{background:#c9483e}.sack-gargantuan{background:#7b51a8}
#codesModal{z-index:14}
#doubleModal.dark-flip{
  background:rgba(0,0,0,.78);
}
.tutorial-card{
  width:min(95vw,760px);
  max-height:90vh;
  overflow:auto;
  text-align:left;
  padding:20px;
}
.tutorial-intro{margin:0 0 14px;text-align:center;font-weight:bold}
.tutorial-steps{display:grid;gap:10px}
.tutorial-step{
  position:relative;
  padding:14px 16px 14px 66px;
  border:3px solid #e1ac20;
  border-radius:14px;
  background:linear-gradient(135deg,#fffdf2,#ffeeb2);
  box-shadow:0 5px 0 #d18b00;
  font-size:1rem;
  line-height:1.35;
}
.tutorial-step::before{
  content:attr(data-step);
  position:absolute;
  left:15px;
  top:50%;
  transform:translateY(-50%);
  width:36px;
  height:36px;
  border-radius:50%;
  display:grid;
  place-items:center;
  color:#fff;
  background:var(--gold-dark);
  font-weight:bold;
}
.tutorial-step:not(:last-child)::after{
  content:"↓";
  position:absolute;
  left:50%;
  bottom:-31px;
  transform:translateX(-50%);
  z-index:2;
  color:#a96600;
  font-size:32px;
  line-height:24px;
  text-shadow:0 1px #fff7d6;
}
.tutorial-step strong{display:block;color:#875500;font-size:1.12rem}
.modal-card{
  position:relative;
  z-index:2;
  width:min(94vw,390px);
  padding:18px;
  border:4px solid var(--gold);
  border-radius:12px;
  background:#fffdf2;
  box-shadow:0 18px 40px rgba(48,36,16,.35);
}
.modal-card h2{
  margin:0 0 8px;
  color:var(--gold-dark);
}
.modal-card input{
  width:min(100%,280px);
  padding:10px;
  border:2px solid #c7aa55;
  border-radius:8px;
  font:inherit;
}
#doubleModal .modal-card{
  overflow:hidden;
}
#rareImageModal{z-index:20;background:transparent;pointer-events:none}
.rare-image-card{
  width:min(90vw,360px);
  padding:0;
  border:0;
  border-radius:0;
  background:transparent;
  box-shadow:none;
  line-height:0;
  pointer-events:none;
  transform:rotate(9deg);
  animation:factoryPop .95s ease-out both;
}
.rare-image-card img{display:block;width:100%;max-height:65vh;object-fit:contain;border:0;border-radius:0}
@keyframes factoryPop{
  0%{opacity:0;transform:translateY(-70px) rotate(9deg) scale(.78)}
  14%,72%{opacity:1;transform:translateY(0) rotate(9deg) scale(1)}
  100%{opacity:0;transform:translateY(20px) rotate(9deg) scale(.94)}
}
.pool-table{
  position:relative;
  overflow:hidden;
  height:170px;
  margin:12px 0;
  border:8px solid #6b3d16;
  border-radius:18px;
  background:radial-gradient(circle at center,#22865b,#0f593b 72%);
  box-shadow:inset 0 0 18px rgba(0,0,0,.35);
}
.black-hole{
  position:fixed;
  left:50%;
  top:50%;
  width:33vmax;
  height:33vmax;
  min-width:320px;
  min-height:320px;
  border-radius:50%;
  transform:translate(-50%,-50%);
  background:
    radial-gradient(circle,#000 0 31%,#16001f 34% 43%,#46115c 44% 53%,rgba(0,0,0,0) 68%),
    conic-gradient(from 0deg,#000,#341045,#050105,#5d177a,#000);
  opacity:0;
  filter:blur(.2px);
  animation:blackHoleSpin 5s linear infinite, blackHoleDrift 4.8s ease-in-out infinite alternate;
  transition:opacity .25s ease;
  z-index:1;
  pointer-events:none;
}
#doubleModal.active .black-hole{
  opacity:.72;
}
#doubleModal.dark-flip .black-hole{
  opacity:.95;
}
#flipCoin{
  position:absolute;
  left:calc(50% - 36px);
  top:48px;
  width:72px;
  height:72px;
  border-radius:50%;
  border:4px solid #a96e00;
  background:#ffd54f;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:36px;
  box-shadow:0 8px 18px rgba(0,0,0,.35);
  z-index:2;
}
#flipCoin.flipping{
  animation:coinFlip 1.95s cubic-bezier(.18,.78,.18,1) both;
}
@keyframes coinFlip{
  0%{transform:rotateY(0) translateY(0)}
  16%{transform:rotateY(220deg) translateY(-34px)}
  32%{transform:rotateY(500deg) translateY(-70px)}
  50%{transform:rotateY(780deg) translateY(-96px)}
  68%{transform:rotateY(1040deg) translateY(-62px)}
  84%{transform:rotateY(1260deg) translateY(-24px)}
  100%{transform:rotateY(1440deg) translateY(0)}
}
@keyframes blackHoleSpin{
  to{transform:translate(-50%,-50%) rotate(360deg)}
}
@keyframes blackHoleDrift{
  from{margin-left:-12px;margin-top:7px}
  to{margin-left:14px;margin-top:-10px}
}
@media(max-width:880px){
  .mini-slots{
    position:static;
    transform:none;
    width:100%;
    min-height:0;
    grid-template-columns:repeat(2,minmax(0,1fr));
    grid-template-areas:"lt rt" "lb rb";
    gap:8px;
    margin:8px auto 14px;
  }
  .mini-grid{
    width:100%;
    min-height:0;
  }
  .mini-cell{font-size:clamp(14px,5vw,20px)}
}
</style>
</head>
<body>
<div id="startModal" class="modal active" aria-live="polite">
  <div class="modal-card start-card" role="dialog" aria-modal="true" aria-labelledby="startTitle">
    <h2 id="startTitle">🐔 Mr. Chicken<br>Slot Machine</h2>
    <p id="startMessage">Complete the tutorial for a secret code!</p>
    <button id="playBtn" onclick="showDifficultyOptions()">Play</button>
    <button onclick="startTutorial()">Tutorial</button>
    <div id="difficultyOptions" class="difficulty-options">
      <button onclick="startGame('easy')">Easy</button>
      <button onclick="startGame('normal')">Normal</button>
      <button onclick="startGame('hard')">Hard</button>
    </div>
  </div>
</div>
<div id="tutorialGuide" aria-live="polite"></div>
<div id="tutorialSackActivation" class="sack-activate"><b>Activate your sacks of coins!</b><div class="bag"></div><div class="bag-name">Small Sack — 10 coins</div><button onclick="activateTutorialSack()">Activate</button></div>
<main>
  <h1>🐔 Mr. Chicken Slot Machine</h1>
  <section class="machine" aria-label="Slot machine">
    <div class="grid" id="grid"></div>
    <div class="mini-slots" id="miniSlots"></div>
    <div class="spin-row">
      <button id="spinBtn" onclick="trySpin()">SPIN (1 coin)</button>
      <button id="spinModeBtn" onclick="toggleSpinMode()">3x Toggle</button>
      <button id="audioBtn" onclick="toggleAudio()">Audio On</button>
    </div>

    <div id="stats"></div>
    <div id="earned">💰 Earned: 0</div>
    <div id="info"></div>

    <div id="market" class="panel">
      <span class="panel-title"><b>🏪 Market</b></span>
      <button id="luckBtn" onclick="buyLuck()">🍀 Luck (25)</button>
      <button id="multBtn" onclick="buyMult()">🔥 Multiplier (50)</button>
      <button id="jackpotBtn" onclick="buyJackpot()">🎰 Jackpot Chance (40)</button>
      <button id="sackBtn" onclick="openSackShop()">💼 Sacks of Coins</button>
    </div>
  </section>
</main>

<button id="sideMenu" onclick="openMenu()">Menu</button>
<button id="darkCoin" aria-label="Double or nothing" onclick="openDoubleOrNothing()"></button>
<div id="sickleOffer">
  <div><b>🌾 Sickle appeared!</b></div>
  <button onclick="buySickle()">Buy for 75%</button>
</div>

<div id="doubleModal" class="modal" aria-live="polite">
  <div class="black-hole" aria-hidden="true"></div>
  <div class="modal-card">
    <h2>Double or Nothing</h2>
    <p>Wager as many coins as you would like. If it lands on your side, your coins double. If it lands on the opposite side, you loose half your coins.</p>
    <input id="doubleWager" type="number" min="2" step="2" value="2" aria-label="Coin wager">
    <div id="doubleError" role="alert"></div>
    <div class="pool-table">
      <div id="flipCoin">🐔</div>
    </div>
    <button onclick="chooseDoubleOrNothing('heads')">Heads 🐔</button>
    <button onclick="chooseDoubleOrNothing('tails')">Tails 🐤</button>
    <button onclick="closeDoubleOrNothing()">Cancel</button>
  </div>
</div>

<div id="sackModal" class="modal" aria-live="polite">
  <div class="modal-card">
    <h2>💼 Sacks of Coins</h2>
    <p>Buy a sack now; it automatically opens when you cannot afford a spin.</p>
    <div class="sack-options">
      <button class="sack-small" onclick="buySack(10)">Small — 10 coins</button>
      <button class="sack-regular" onclick="buySack(100)">Regular — 100 coins</button>
      <button class="sack-large" onclick="buySack(1000)">Large — 1,000 coins</button>
      <button class="sack-massive" onclick="buySack(10000)">Massive — 10,000 coins</button>
      <button class="sack-gargantuan" onclick="buySack(100000)">Gargantuan — 100,000 coins</button>
    </div>
    <button onclick="closeSackShop()">Close</button>
  </div>
</div>

<div id="codesModal" class="modal" aria-live="polite">
  <div class="modal-card">
    <h2>Codes</h2>
    <input id="codeInput" placeholder="Enter code">
    <br>
    <button onclick="submitCode()">Submit</button>
    <button onclick="closeCodes()">Close</button>
  </div>
</div>

<div id="menuModal" class="modal" aria-live="polite">
  <div class="modal-card">
    <h2>Menu</h2>
    <button onclick="toggleAudio()" id="menuAudioBtn">Audio On</button>
    <button onclick="openHelp()">How It Works</button>
    <button onclick="openPatternsMenu()">Patterns Menu</button>
    <button onclick="openCodes()">Codes</button>
    <button onclick="closeMenu()">Close</button>
  </div>
</div>

<div id="retryModal" class="modal" aria-live="polite">
  <div class="modal-card retry-card"><h2>Try again</h2><p id="retryHint"></p><button onclick="closeRetryModal()">Okay</button></div>
</div>

<div id="helpModal" class="modal" aria-live="polite">
  <div class="modal-card tutorial-card" role="dialog" aria-modal="true" aria-labelledby="tutorialTitle">
    <h2 id="tutorialTitle">🐝 How It Works</h2>
    <p class="tutorial-intro">Follow the big arrows — every spin can build your chicken fortune!</p>
    <div class="tutorial-steps">
      <article class="tutorial-step" data-step="1"><strong>Spin the 5 × 3 machine</strong>Press <b>SPIN</b> to spend coins and fill the 3 rows of 5 symbols. Use the 3× toggle for three boards at once.</article>
