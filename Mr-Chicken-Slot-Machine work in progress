function patternAmount(pattern){
  return pattern.multiplier*shopMult*streakMult;
}

function findPatterns(board){
  const patterns=[];

  function add(idxs,multiplier,name){
    const symbol=board[idxs[0]];
    patterns.push({idxs,multiplier,symbol,name});
  }

  // Border: every outer square matches. The centre square is intentionally
  // excluded, so this is a true frame rather than the old "eye" pattern.
  const borderIdxs=[0,1,2,3,4,5,9,10,11,12,13,14];
  if(borderIdxs.every(i=>board[i]===board[0])){
    add(borderIdxs,18,"border");
  }

  // Conventional 5-column zig: top → middle → bottom → middle → top.
  const zigIdxs=[0,6,12,8,4];
  if(zigIdxs.every(i=>board[i]===board[zigIdxs[0]])){
    add(zigIdxs,15,"zig");
  }

  // Conventional 5-column zag: bottom → middle → top → middle → bottom.
  const zagIdxs=[10,6,2,8,14];
  if(zagIdxs.every(i=>board[i]===board[zagIdxs[0]])){
    add(zagIdxs,15,"zag");
  }

  // X from the supplied sketch: the two upper/lower inner squares plus centre.
  // It is evaluated before the 1-by-5 row patterns.
  const xIdxs=[1,3,7,11,13];
  if(xIdxs.every(i=>board[i]===board[xIdxs[0]])) add(xIdxs,12,"X");

  for(let r=0;r<3;r++){
    const b=r*5;
    if(board[b]===board[b+1]&&board[b]===board[b+2]&&board[b]===board[b+3]&&board[b]===board[b+4]){
      add([b,b+1,b+2,b+3,b+4],9,"1 by 5");
    }else{
      const leftFour=board[b]===board[b+1]&&board[b]===board[b+2]&&board[b]===board[b+3];
      const rightFour=board[b+1]===board[b+2]&&board[b+1]===board[b+3]&&board[b+1]===board[b+4];
      if(leftFour) add([b,b+1,b+2,b+3],6,"1 by 4");
      else if(rightFour) add([b+1,b+2,b+3,b+4],6,"1 by 4");
      else{
        for(let start=0;start<=2;start++){
          const i=b+start;
          if(board[i]===board[i+1]&&board[i]===board[i+2]) add([i,i+1,i+2],3,"1 by 3");
        }
      }
    }
  }

  for(let c=0;c<5;c++){
    if(board[c]===board[c+5]&&board[c]===board[c+10]) add([c,c+5,c+10],3,"1 by 3");
  }

  // Every diagonal is its own pattern, including the two that cross through X.
  [[0,6,12],[1,7,13],[2,8,14],[2,6,10],[3,7,11],[4,8,12]].forEach(idxs=>{
    if(idxs.every(index=>board[index]===board[idxs[0]])) add(idxs,3,"diagonal");
  });

  if(board.every(symbol=>symbol===board[0])){
    add([...Array(15).keys()],30,"jackpot");
  }

  patterns.forEach(pattern=>pattern.amount=patternAmount(pattern));
  patterns.sort((a,b)=>a.multiplier-b.multiplier);
  return patterns;
}

function findJackpotPatterns(board){
  const symbol=board[0];
  const add=(idxs,multiplier,name)=>({idxs,multiplier,symbol,name,amount:multiplier*shopMult*streakMult});
  // Jackpot-only order. Individual diagonals are omitted because all six are
  // pieces of the Zig, Zag, or X patterns that follow.
  return [
    add([1,6,11],3,"3 by 1"),
    add([2,7,12],3,"3 by 1"),
    add([3,8,13],3,"3 by 1"),
    add([5,6,7,8,9],9,"1 by 5"),
    add([1,3,7,11,13],12,"X"),
    add([0,6,12,8,4],15,"zig"),
    add([10,6,2,8,14],15,"zag"),
    add([0,1,2,3,4,5,9,10,11,12,13,14],18,"border"),
    add([...Array(15).keys()],30,"jackpot")
  ];
}

function evaluateBoard(board,cells,animate=false){
  const patterns=findPatterns(board);
  const reward=patterns.reduce((sum,pattern)=>sum+pattern.amount,0);
  if(!animate){
    patterns.forEach(pattern=>pattern.idxs.forEach(i=>cells[i].classList.add("win")));
  }
  return {reward,patterns};
}

function animatePatterns(patterns,cells,done){
  if(patterns.length===0){
    done();
    return;
  }
  const cellList=Array.from(cells);
  let index=0;
  function step(){
    cellList.forEach(cell=>cell.classList.remove("win"));
    const pattern=patterns[index];
    pattern.idxs.forEach(i=>cells[i].classList.add("win"));
    playPatternSound(pattern,index);
    document.getElementById("info").textContent=`${pattern.name} x${pattern.multiplier}: +${pattern.amount}`;
    index++;
    if(index<patterns.length){
      setTimeout(step,520);
    }else{
      setTimeout(()=>{
        patterns.forEach(pattern=>pattern.idxs.forEach(i=>cells[i].classList.add("win")));
        done();
      },320);
    }
  }
  step();
}

function jackpotReward(cells,jackpotSymbol){
  document.querySelectorAll(".cell").forEach(c=>c.classList.add("win"));
  beep(900,0.45);
  return (75+symbolPayouts[jackpotSymbol])*shopMult*streakMult;
}

function playJackpotAnimation(cells,jackpotSymbol,done){
  grid.classList.add("jackpot-mode");
  document.getElementById("info").classList.add("jackpot-text");
  document.getElementById("info").textContent="";
  document.querySelectorAll(".cell").forEach(c=>c.classList.remove("win","locked","suspense","final-focus","jackpot-pop"));

  for(let r=0;r<3;r++){
    for(let c=0;c<4;c++){
      const lockedCell=cells[r*5+c];
      lockedCell.textContent=jackpotSymbol;
      lockedCell.classList.add("locked");
    }
  }

  for(let r=0;r<3;r++){
    cells[r*5+4].classList.add("suspense");
  }

  let suspense=0;
  function finalColumnTick(){
    const spinningRows=suspense<8?[0,1,2]:suspense<16?[1,2]:[2];
    spinningRows.forEach(r=>{
      cells[r*5+4].textContent=symbols[Math.floor(Math.random()*symbols.length)];
    });
    if(suspense>=16){
      cells[14].classList.add("final-focus");
    }
    suspense++;

    if(suspense===8){
      const firstCell=cells[4];
      firstCell.textContent=jackpotSymbol;
      firstCell.classList.remove("suspense");
      firstCell.classList.add("locked","jackpot-pop");
      beep(520,0.1);
    }

    if(suspense===16){
      const secondCell=cells[9];
      secondCell.textContent=jackpotSymbol;
      secondCell.classList.remove("suspense");
      secondCell.classList.add("locked","jackpot-pop");
      cells[14].classList.add("final-focus");
      beep(640,0.12);
    }

    if(suspense>27){
      for(let r=0;r<3;r++){
        const finalCell=cells[r*5+4];
        finalCell.textContent=jackpotSymbol;
        finalCell.classList.remove("suspense","final-focus");
        finalCell.classList.add("jackpot-pop");
      }
      jackpotReward(cells,jackpotSymbol);
      done();
      setTimeout(()=>{
        grid.classList.remove("jackpot-mode");
        document.getElementById("info").classList.remove("jackpot-text");
        document.querySelectorAll(".cell").forEach(c=>c.classList.remove("locked","final-focus","jackpot-pop"));
      },1800);
    }else{
      const slowPhase=Math.max(0,suspense-16);
      const nextDelay=70+Math.pow(slowPhase/11,2)*135;
      setTimeout(finalColumnTick,nextDelay);
    }
  }
  finalColumnTick();
}

function finishSpin(reward,message){
  const usedMult=shopMult*streakMult;
  if(sickleRolls>0&&reward>0){
    reward*=2;
    sickleRolls--;
    message=(message||`WIN! Mult x${usedMult}`)+" | Sickle x2";
  }else if(sickleRolls>0){
    sickleRolls--;
  }

  if(reward>0){
    streakMult=Math.min(streakMult+1,5);
    beep(700,0.2);
    document.getElementById("info").textContent=message||`WIN! Mult x${usedMult}`;
  }else{
    streakMult=1;
    document.getElementById("info").textContent="No win";
  }

  reward=applyCoinMode(reward);
  if(!infiniteCoins) coins+=reward;
  spinning=false;
  document.getElementById("earned").textContent="💰 Earned: "+reward;
  if(!(tutorialActive&&tutorialStep===5)) checkSacks();
  update();
  advanceTutorialAfterSpin();
  advanceTutorialLossSpin();
  if(gambleHintPending){
    document.getElementById("info").textContent="Wanna gamble your coins? Click the bottom left.";
    gambleHintPending=false;
  }
  maybeShowSickleOffer();
}

function trySpin(){
  const required=spinCost()*spinBatch;
  if(!spinning&&!infiniteCoins&&coins<required&&!hasSacks()){
    const hints=["Buy a Sack of Coins in the Market.","Use code \"Lucky Ducky\" for a free Luck upgrade.","Try Double or Nothing from the bottom-left coin."];
    document.getElementById("retryHint").textContent=hints[Math.floor(Math.random()*hints.length)];
    document.getElementById("retryModal").classList.add("active");
    return;
  }
  spin();
}

function closeRetryModal(){
  document.getElementById("retryModal").classList.remove("active");
}

function spin(){
  if(spinBatch>1&&!guaranteedJackpot){
    spinFive();
    return;
  }
  const cost=spinCost();
  if(!(tutorialActive&&tutorialStep===5)) checkSacks(cost);
  if((!infiniteCoins&&coins<cost)||spinning) return;
  spinning=true;
  if(!infiniteCoins) coins-=cost;
  registerSpin();
  clearWin();
  beep(300,0.08);
  update();

  const cells=document.getElementsByClassName("cell");
  const luckySymbol=symbols[Math.floor(Math.random()*symbols.length)];
  const isJackpot=guaranteedJackpot||Math.random()<(0.015+jackpotLevel*0.005);
  guaranteedJackpot=false;
  let t=0;

  const anim=setInterval(()=>{
    for(let i=0;i<15;i++){
      cells[i].textContent=symbols[Math.floor(Math.random()*symbols.length)];
    }
    t++;
    if(t>15){
      clearInterval(anim);

      if(isJackpot){
        const jackpotSymbol=symbols[Math.floor(Math.random()*symbols.length)];
        const board=Array(15).fill(jackpotSymbol);
        for(let i=0;i<15;i++){
          cells[i].textContent=jackpotSymbol;
        }
        const jackpotPatterns=findJackpotPatterns(board);
        const regularPatterns=jackpotPatterns.filter(pattern=>pattern.name!=="jackpot");
        const result={
          patterns:jackpotPatterns,
          reward:jackpotPatterns.reduce((sum,pattern)=>sum+pattern.amount,0)
        };
        animatePatterns(regularPatterns,cells,()=>{
          // Wait until every normal pattern has been shown before the jackpot music.
          playJackpotSoundtrack();
          playJackpotAnimation(cells,jackpotSymbol,()=>{
            finishSpin(result.reward,`JACKPOT! ${jackpotSymbol} Mult x${shopMult*streakMult}`);
          });
        });
        return;
      }

      const board=tutorialActive&&tutorialStep===0?createTutorialBoard():tutorialActive&&tutorialStep===5?createTutorialLossBoard():createSpinBoard(luckySymbol);
      for(let i=0;i<15;i++) cells[i].textContent=board[i];

      const result=evaluateBoard(board,cells,true);
      const luckyText=luck>0?` | Lucky ${luckySymbol}`:"";
      animatePatterns(result.patterns,cells,()=>{
        finishSpin(result.reward,result.reward>0?`WIN! Mult x${shopMult*streakMult}${luckyText}`:null);
      });
    }
  },55);
}

function spinMiniBoard(cells){
  return new Promise(resolve=>{
    const luckySymbol=symbols[Math.floor(Math.random()*symbols.length)];
    let t=0;
    cells.forEach(c=>c.classList.remove("win"));
    const anim=setInterval(()=>{
      cells.forEach(cell=>{
        cell.textContent=symbols[Math.floor(Math.random()*symbols.length)];
      });
      t++;
      if(t>16){
        clearInterval(anim);
        const board=createSpinBoard(luckySymbol);
        for(let i=0;i<15;i++) cells[i].textContent=board[i];
        resolve(evaluateBoard(board,cells).reward);
      }
    },50);
  });
}

function spinFive(){
  const cost=spinCost()*spinBatch;
  checkSacks(cost);
  if(spinning||(!infiniteCoins&&coins<cost)) return;
  spinning=true;
  clearWin();
  if(!infiniteCoins) coins-=cost;
  // A 5× press is one player spin event for the rare Factory popup.
  registerSpin();
  beep(340,0.1);
  update();

  const mainCells=Array.from(document.getElementsByClassName("cell"));
  Promise.all([spinMiniBoard(mainCells),...miniBoards.slice(0,spinBatch-1).map(cells=>spinMiniBoard(cells))]).then(rewards=>{
    let total=rewards.reduce((sum,val)=>sum+val,0);
    let message=total>0?`${spinBatch}x spin won ${total}`:`${spinBatch}x spin: no win`;
    if(sickleRolls>0){
      if(total>0){
        total*=2;
        message=`${spinBatch}x spin won ${total} | Sickle x2`;
      }
      sickleRolls--;
    }
    if(total>0){
      streakMult=Math.min(streakMult+1,5);
      document.getElementById("info").textContent=message;
      beep(740,0.18);
    }else{
      streakMult=1;
      document.getElementById("info").textContent=message;
    }
    total=applyCoinMode(total);
    if(!infiniteCoins) coins+=total;
    spinning=false;
    document.getElementById("earned").textContent="💰 Earned: "+total;
    checkSacks();
    update();
    advanceTutorialAfterSpin();
    if(gambleHintPending){
      document.getElementById("info").textContent="Wanna gamble your coins? Click the bottom left.";
      gambleHintPending=false;
    }
    maybeShowSickleOffer();
  });
}

function buyLuck(){
  const cost=luckCost();
  if(!spinning&&spend(cost)){
    luck++;
    spinPriceUpgradeCount++;
    completeTutorialUpgrade();
    document.getElementById("info").textContent=`Luck upgraded to ${luck}`;
    update();
  }
}

function buyMult(){
  const cost=multCost();
  if(!spinning&&spend(cost)){
    shopMult++;
    spinPriceUpgradeCount++;
    completeTutorialUpgrade();
    document.getElementById("info").textContent=`Multiplier upgraded to x${shopMult}`;
    update();
  }
}

function buyJackpot(){
  const cost=jackpotCost();
  if(!spinning&&spend(cost)){
    jackpotLevel++;
    spinPriceUpgradeCount++;
    completeTutorialUpgrade();
    document.getElementById("info").textContent=`Jackpot chance upgraded to ${Math.round((0.015+jackpotLevel*0.005)*100)}%`;
    update();
  }
}

function openSackShop(){
  document.getElementById("sackModal").classList.add("active");
}

function closeSackShop(){
  document.getElementById("sackModal").classList.remove("active");
}

function buySack(amount){
  if(tutorialActive&&tutorialStep===4&&amount!==10){
    document.getElementById("info").textContent="For this tutorial, buy the Small Sack.";
    return;
  }
  if(!spinning&&spend(amount)){
    sackInventory[amount]++;
    document.getElementById("info").textContent=`Saved a ${amount.toLocaleString()}-coin sack`;
    update();
    if(tutorialActive&&tutorialStep===4&&amount===10){
      closeSackShop();
      tutorialStep=5;
      setTutorialMessage("Tutorial — Step 6: Spin two times. These rounds will not make any patterns.");
    }
  }
}

function buySickle(){
  if(!sickleOfferActive) return;
  const cost=sickleCost();
  if(!spinning&&spend(cost)){
    sickleRolls+=2;
    hideSickleOffer();
    document.getElementById("info").textContent="Sickle ready: next 2 spins pay x2";
    update();
  }
}

function toggleAudio(){
  audioOn=!audioOn;
  trackTutorialMenu("audio");
  update();
}

function toggleSpinMode(){
  if(spinning) return;
  spinBatch=spinBatch===3?1:3;
  update();
}

function openDoubleOrNothing(){
  if(spinning) return;
  checkSacks(2);
  if(!infiniteCoins&&coins<2) return;
  doubleChoice=null;
  const coin=document.getElementById("flipCoin");
  const wager=document.getElementById("doubleWager");
  const maxEven=infiniteCoins?999999998:Math.max(0,coins-(coins%2));
  wager.value=Math.min(maxEven,Math.max(2,Number(wager.value)||2));
  wager.max=infiniteCoins?999999999:coins;
  document.getElementById("doubleError").textContent="";
  coin.textContent="🐔";
  coin.classList.remove("flipping");
  document.getElementById("doubleModal").classList.add("active");
}

function closeDoubleOrNothing(){
  document.getElementById("doubleModal").classList.remove("active","dark-flip");
}

function chooseDoubleOrNothing(choice){
  if(spinning) return;
  const coin=document.getElementById("flipCoin");
  if(coin.classList.contains("flipping")) return;
  const error=document.getElementById("doubleError");
  error.textContent="";
  let wager=Math.floor(Number(document.getElementById("doubleWager").value));
  if(!Number.isFinite(wager)||wager<2){
    document.getElementById("info").textContent="Wager must be an even number of at least 2.";
    return;
  }
  if(wager%2!==0){
    error.textContent="Number has to be even!";
    return;
  }
  if(!infiniteCoins) wager=Math.min(wager,coins);
  if(wager%2!==0){
    error.textContent="Number has to be even!";
    return;
  }
  if(wager<2) return;
  doubleChoice=choice;
  const won=Math.random()<.55;
  const result=won?choice:(choice==="heads"?"tails":"heads");
  const heads=result==="heads";
  if(!infiniteCoins) coins-=wager;
  document.getElementById("earned").textContent="💰 Earned: -"+wager;
  document.getElementById("info").textContent=`Wagered ${wager} coins...`;
  update();
  coin.classList.remove("flipping");
  void coin.offsetWidth;
  coin.classList.add("flipping");
  document.getElementById("doubleModal").classList.add("dark-flip");
  playDarkFlipMusic();
  beep(520,0.1);
  // Reveal the result during the final descent, before the coin reaches the table.
  // This prevents it from visibly landing on the old side and then changing.
  setTimeout(()=>{
    coin.textContent=heads?"🐔":"🐤";
  },1600);

  setTimeout(()=>{
    coin.classList.remove("flipping");
    coin.textContent=heads?"🐔":"🐤";
    const won=doubleChoice===result;
    if(won){
      const gained=infiniteCoins?"Infinity":wager*2;
      if(!infiniteCoins) coins+=wager*2;
      document.getElementById("earned").textContent="💰 Earned: "+gained;
      document.getElementById("info").textContent=`${heads?"🐔 Heads":"🐤 Tails"}! You guessed right. Wager doubled!`;
      beep(880,0.22);
    }else{
      document.getElementById("earned").textContent="💰 Earned: 0";
      document.getElementById("info").textContent=`${heads?"🐔 Heads":"🐤 Tails"}. Wrong guess. No coins came back.`;
      beep(110,0.35);
      checkSacks();
    }
    update();
    advanceTutorialAfterFlip();
    setTimeout(closeDoubleOrNothing,900);
  },2100);
}

function openMenu(){
  document.getElementById("menuModal").classList.add("active");
}

function closeMenu(){
  document.getElementById("menuModal").classList.remove("active");
}

function openHelp(){
  trackTutorialMenu("help");
  document.getElementById("helpModal").classList.add("active");
}

